# Secret used to sign Better Auth sessions. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL Better Auth uses to build callback/cookie URLs.
BETTER_AUTH_URL=http://localhost:3000

# Where the SQLite database file lives (created automatically).
DATABASE_PATH=.data/nuxtly.sqlite

# Public base used when displaying short links (defaults to the request origin).
NUXT_PUBLIC_SHORT_BASE_URL=http://localhost:3000

# Nuxtly API key consumed by .cursor/mcp.json as ${env:NUXTLY_API_KEY}.
# Generate one from the dashboard's "API keys for MCP" section.
# NOTE: Cursor resolves ${env:...} from the environment that launched it
# (the system environment), not this file. Export it where Cursor can see it,
# e.g. `launchctl setenv NUXTLY_API_KEY <key>` (macOS) or your shell profile,
# then restart Cursor.
NUXTLY_API_KEY=
